---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillGroup from "../components/SkillGroup.astro";
import Timeline from "../components/Timeline.astro";
import ContactFooter from "../components/ContactFooter.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import Reveal from "../components/Reveal.astro";
import Icon from "../components/Icon.astro";
import {
  profile,
  experiences,
  projects,
  leadership,
  education,
  skills,
  honors,
} from "../data/resume-data";
import downloadSvg from "lucide-static/icons/download.svg?raw";
import arrowDownSvg from "lucide-static/icons/arrow-down.svg?raw";
import arrowUpRightSvg from "lucide-static/icons/arrow-up-right.svg?raw";
import mailSvg from "lucide-static/icons/mail.svg?raw";
import phoneSvg from "lucide-static/icons/phone.svg?raw";

const [frc, avexel] = [experiences[0], experiences[1]];
const rest = experiences.slice(2);

const navLinks = [
  ["About", "#about"],
  ["Experience", "#experience"],
  ["Projects", "#projects"],
  ["Leadership", "#leadership"],
  ["Education", "#education"],
  ["Contact", "#contact"],
] as const;

const heroFacts = [
  ["Base", "Houghton, MI"],
  ["Program", "ME + AE"],
  ["Class", "2030"],
  ["Focus", "Motorsport · Robotics"],
] as const;

const keyOutcomes = [
  "FIRST Impact Award",
  "World Championship qualification",
  "Regional + state competition runs",
  "Led a largely rookie roster",
  "Extensive outreach & mentorship",
];

const contactCards = [
  { icon: mailSvg, label: "Email", value: profile.email, href: `mailto:${profile.email}`, external: false },
  { icon: arrowUpRightSvg, label: "LinkedIn", value: "brooke-winkler", href: profile.linkedin, external: true },
  { icon: phoneSvg, label: "Phone", value: profile.phone, href: `tel:${profile.phone.replace(/[^+\d]/g, "")}`, external: false },
];
---
<Layout>
  <a
    href="#about"
    class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:bg-ink focus:text-paper focus:px-4 focus:py-2"
  >
    Skip to content
  </a>

  <!-- TOP BAR -->
  <header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur">
    <div class="relative mx-auto max-w-6xl px-4 md:px-8 flex items-center gap-3 h-16">
      <a href="#top" class="flex items-center gap-2.5" aria-label="Brooke Winkler — home">
        <span
          class="flex h-8 w-8 items-center justify-center bg-ink font-display text-[15px] font-semibold text-paper"
        >
          BW
        </span>
        <span class="text-[15px] font-semibold tracking-tight">Brooke Winkler</span>
      </a>
      <nav
        aria-label="Sections"
        class="ml-auto hidden lg:flex items-center gap-6 font-mono text-[12px] font-medium uppercase tracking-[0.14em] text-ink-soft"
      >
        {navLinks.map(([label, href]) => (
          <a href={href} class="transition-colors hover:text-accent">{label}</a>
        ))}
      </nav>
      <a
        href="/Brooke-Winkler-Resume.pdf"
        download
        class="ml-auto lg:ml-4 inline-flex items-center gap-2 bg-accent px-4 py-2 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-accent-deep"
      >
        <Icon src={downloadSvg} class="h-3.5 w-3.5" />
        <span class="hidden sm:inline">Download resume</span>
        <span class="sm:hidden">Resume</span>
      </a>
      <ScrollProgress />
    </div>
  </header>

  <main id="main" class="mx-auto w-full min-w-0 max-w-6xl px-4 md:px-8">
    <!-- HERO -->
    <section id="top" aria-label="Introduction" class="pt-16 md:pt-24 pb-12 md:pb-16">
      <Reveal>
        <p
          class="inline-flex items-center gap-2.5 border border-ink/15 bg-card px-3.5 py-1.5 font-mono text-[11.5px] font-medium uppercase tracking-[0.16em] text-ink-soft"
        >
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          Open to Summer 2027 internships
        </p>
        <p
          class="mt-7 font-mono text-[12.5px] font-medium uppercase tracking-[0.24em] text-accent-deep"
        >
          Mechanical + Aerospace — Michigan Tech
        </p>
        <h1
          class="mt-3 font-display text-6xl sm:text-7xl md:text-8xl font-semibold uppercase leading-[0.9] tracking-tight text-ink"
        >
          Brooke<br />
          Winkler<span class="text-accent">.</span>
        </h1>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/Brooke-Winkler-Resume.pdf"
            download
            class="inline-flex items-center gap-2 bg-accent px-6 py-3.5 font-mono text-[12.5px] font-semibold uppercase tracking-[0.14em] text-white transition-colors hover:bg-accent-deep"
          >
            <Icon src={downloadSvg} class="h-4 w-4" /> Download resume
          </a>
          <a
            href="#projects"
            class="inline-flex items-center gap-2 border-2 border-ink px-6 py-3.5 font-mono text-[12.5px] font-semibold uppercase tracking-[0.14em] text-ink transition-colors hover:bg-ink hover:text-paper"
          >
            View projects <Icon src={arrowDownSvg} class="h-4 w-4" />
          </a>
        </div>
        <dl class="mt-10 grid grid-cols-2 gap-px border border-ink/12 bg-ink/12 sm:grid-cols-4">
          {heroFacts.map(([term, value]) => (
            <div class="bg-paper px-4 py-3">
              <dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">{term}</dt>
              <dd class="mt-0.5 text-[13.5px] font-semibold text-ink">{value}</dd>
            </div>
          ))}
        </dl>
      </Reveal>
    </section>

    <!-- ABOUT -->
    <section id="about" aria-label="About" class="py-14 md:py-20 scroll-mt-20 border-t border-ink/10">
      <SectionHeader num="01" eyebrow="Profile" title="About" />
      <div class="grid gap-5 md:grid-cols-3">
        <Reveal class="md:col-span-2">
          <div class="h-full border border-ink/12 bg-card p-6 md:p-9">
            <p class="text-[16.5px] leading-relaxed text-ink">
              I&apos;m a first-year dual-degree <strong>Mechanical + Aerospace Engineering</strong> student
              at <strong>Michigan Tech</strong>. In high school I captained an FRC robotics team —
              designing and wiring robots that had to work in front of a crowd — and did sales for
              a student web company that ended up <strong>funding a competition robot</strong>.
              Long-term, I&apos;d love to work in <strong>Formula 1 and high-performance motorsports</strong> —
              powertrains, vehicle development, strategy.
            </p>
            <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
              I also do theatre tech, play golf, mentor young robotics teams, and read F1 technical
              regulations for fun. I do my best work on teams with a deadline.
            </p>
          </div>
        </Reveal>
        <Reveal delay={120}>
          <aside class="h-full bg-ink p-6 md:p-7 text-paper" aria-label="Currently">
            <p class="font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-paper/50">
              Currently
            </p>
            <ul class="mt-4 divide-y divide-paper/15 text-[14px] leading-snug">
              <li class="py-3 first:pt-0">
                <strong class="font-semibold">Researching</strong>{" "}
                <span class="text-paper/70">F1 2026 power unit regulations and hybrid deployment</span>
              </li>
              <li class="py-3">
                <strong class="font-semibold">Sharpening</strong>{" "}
                <span class="text-paper/70">a SolidWorks-to-fabrication workflow for Formula SAE</span>
              </li>
              <li class="py-3">
                <strong class="font-semibold">Targeting</strong>{" "}
                <span class="text-paper/70">a Summer 2027 motorsports internship</span>
              </li>
              <li class="py-3 last:pb-0">
                <strong class="font-semibold">Outside class</strong>{" "}
                <span class="text-paper/70">robotics mentoring, golf, theatre tech, and F1 regs</span>
              </li>
            </ul>
            <p
              class="mt-4 border-t border-paper/15 pt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-paper/50"
            >
              Golf · Stage crew · Snow · Backpacking
            </p>
          </aside>
        </Reveal>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section
      id="experience"
      aria-label="Experience"
      class="py-14 md:py-20 scroll-mt-20 border-t border-ink/10"
    >
      <SectionHeader num="02" eyebrow="Career" title="Experience" />
      <Reveal>
        <Timeline />
      </Reveal>
      <div id="experience-list" class="mt-6 space-y-6 scroll-mt-24">
        <ExperienceEntry exp={frc} />
        <div class="grid gap-6 lg:grid-cols-[1fr_320px] lg:items-start">
          <ExperienceEntry exp={avexel} />
          <Reveal class="h-full">
            <aside
              class="border border-ink/12 border-t-2 border-t-accent bg-card p-6 lg:sticky lg:top-24"
              aria-label="Key outcomes"
            >
              <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-deep">
                Key outcomes
              </p>
              <ul class="mt-3 divide-y divide-ink/10 text-[14px] font-medium leading-snug">
                {keyOutcomes.map((h) => (
                  <li class="py-2.5 first:pt-1 last:pb-0">{h}</li>
                ))}
              </ul>
            </aside>
          </Reveal>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {rest.map((e) => (
            <ExperienceEntry exp={e} />
          ))}
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section
      id="projects"
      aria-label="Engineering and projects"
      class="py-14 md:py-20 scroll-mt-20 border-t border-ink/10"
    >
      <SectionHeader num="03" eyebrow="Selected work" title="Projects" />
      <div class="grid gap-6 md:grid-cols-2">
        {projects.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
    </section>

    <!-- LEADERSHIP -->
    <section
      id="leadership"
      aria-label="Leadership"
      class="py-14 md:py-20 scroll-mt-20 border-t border-ink/10"
    >
      <SectionHeader num="04" eyebrow="Teams" title="Leadership" />
      <div class="grid gap-5 md:grid-cols-3">
        {leadership.map((l, i) => (
          <Reveal tag="article" delay={i * 80}>
            <div class="h-full border border-ink/12 bg-card p-6">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
                L.0{i + 1} — {l.dates}
              </p>
              <h3
                class="mt-2 font-display text-[22px] font-semibold uppercase leading-tight tracking-tight text-ink"
              >
                {l.title}
              </h3>
              <p class="text-sm text-muted">{l.org}</p>
              <p class="mt-3 text-[14.5px] leading-relaxed text-ink-soft">{l.text}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </section>

    <!-- EDUCATION -->
    <section
      id="education"
      aria-label="Education"
      class="py-14 md:py-20 scroll-mt-20 border-t border-ink/10"
    >
      <SectionHeader num="05" eyebrow="Background" title="Education" />
      <div class="grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-5">
          {education.map((e) => (
            <Reveal tag="article">
              <div
                class:list={[
                  "border bg-card p-6 md:p-7",
                  e.highlight ? "border-ink border-l-2 border-l-accent" : "border-ink/12",
                ]}
              >
                <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
                  {e.dates} · {e.place}
                </p>
                <h3
                  class="mt-1.5 font-display text-2xl font-semibold uppercase leading-tight tracking-tight text-ink"
                >
                  {e.school}
                </h3>
                <p class="mt-1 text-[15px] font-medium text-ink">{e.degree}</p>
                <p class="mt-2 text-[14.5px] leading-relaxed text-ink-soft">{e.detail}</p>
              </div>
            </Reveal>
          ))}
        </div>
        <Reveal delay={100}>
          <aside class="h-full border border-ink/12 bg-card p-6 md:p-7" aria-label="Honors">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-muted">
              Honors &amp; awards
            </p>
            <ul class="mt-3 divide-y divide-ink/10">
              {honors.map((h) => (
                <li class="py-2.5 text-[14px] font-medium text-ink first:pt-1 last:pb-0">
                  {h}
                </li>
              ))}
            </ul>
          </aside>
        </Reveal>
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" aria-label="Skills" class="py-14 md:py-20 scroll-mt-20 border-t border-ink/10">
      <SectionHeader num="06" eyebrow="Toolkit" title="Skills" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {skills.map((s, i) => (
          <SkillGroup group={s.group} items={s.items} index={`S.0${i + 1}`} />
        ))}
      </div>
    </section>

    <!-- CONTACT -->
    <section
      id="contact"
      aria-label="Contact"
      class="py-14 md:py-20 scroll-mt-20 border-t border-ink/10"
    >
      <SectionHeader num="07" eyebrow="Reach out" title="Contact" />
      <div class="grid gap-4 md:grid-cols-3 mb-10">
        {contactCards.map((c) => (
          <Reveal>
            <a
              href={c.href}
              target={c.external ? "_blank" : undefined}
              rel={c.external ? "noreferrer" : undefined}
              class="group flex items-center gap-4 border border-ink/12 bg-card p-5 transition-colors hover:border-ink"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center bg-ink text-paper transition-colors group-hover:bg-accent"
              >
                <Icon src={c.icon} class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-mono text-[11px] uppercase tracking-[0.16em] text-muted"
                  >{c.label}</span
                >
                <span class="block truncate text-[15px] font-semibold text-ink">{c.value}</span>
              </span>
            </a>
          </Reveal>
        ))}
      </div>
      <ContactFooter />
      <p class="mt-8 text-center text-[13px] text-muted">
        Built with an unreasonable appreciation for things that move · © 2026 {profile.name}
      </p>
    </section>
  </main>
</Layout>
