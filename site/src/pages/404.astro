---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Not found — Brooke Winkler"
  description="This page doesn't exist. Back to Brooke Winkler's site."
>
  <main class="mx-auto flex w-full max-w-6xl flex-1 flex-col items-start justify-center px-4 md:px-8 py-24">
    <p class="font-mono text-[12px] font-medium uppercase tracking-[0.22em] text-muted">
      <span class="font-semibold text-accent">404</span>
      <span aria-hidden="true" class="mx-2 text-ink/25">/</span>
      Not found
    </p>
    <h1
      class="mt-2 font-display text-5xl md:text-7xl font-semibold uppercase leading-[0.95] tracking-tight text-ink"
    >
      Nothing here<span class="text-accent">.</span>
    </h1>
    <p class="mt-5 max-w-xl text-[15.5px] leading-relaxed text-ink-soft">
      This page doesn&apos;t exist. The rest of the site does.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 bg-accent px-6 py-3.5 font-mono text-[12.5px] font-semibold uppercase tracking-[0.14em] text-white transition-colors hover:bg-accent-deep"
    >
      Back to the site
    </a>
  </main>
</Layout>
