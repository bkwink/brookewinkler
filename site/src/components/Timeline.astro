---
import { experiences } from "../data/resume-data";

const SHORT: Record<string, string> = {
  frc: "FRC 7598",
  avexel: "Avexel",
  redbull: "Red Bull",
  enzu: "Enzu",
  theatre: "Theatre",
  golf: "Golf",
};

const first = experiences[0];
const preview = experiences.map((e) => ({
  id: e.id,
  index: e.index,
  role: e.role,
  org: e.org,
  location: e.location,
  dates: e.dates,
  summary: e.summary,
}));
---
<div data-timeline class="border border-ink/12 bg-card p-6 md:p-7">
  <p class="font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-muted">
    Browse roles
  </p>
  <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Roles">
    {experiences.map((e) => (
      <button
        type="button"
        data-timeline-btn={e.id}
        aria-pressed={e.id === first.id ? "true" : "false"}
        class="border border-ink/15 bg-transparent px-4 py-2 font-mono text-[12px] font-medium uppercase tracking-[0.1em] text-ink-soft transition-colors hover:border-ink/50 hover:text-ink"
      >
        {SHORT[e.id] ?? e.org}
      </button>
    ))}
  </div>

  <div class="mt-6 border-t border-ink/10 pt-5" aria-live="polite">
    <p data-timeline-index class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
      {first.index} · {first.dates}
    </p>
    <p
      data-timeline-role
      class="mt-1.5 font-display text-[22px] font-semibold uppercase leading-tight tracking-tight text-ink"
    >
      {first.role}
    </p>
    <p data-timeline-org class="mt-1 text-sm font-medium text-ink-soft">
      {first.org} · {first.location}
    </p>
    <p data-timeline-summary class="mt-2 max-w-3xl text-[14.5px] leading-relaxed text-ink-soft">
      {first.summary}
    </p>
    <a
      href="#experience-list"
      class="mt-3 inline-block font-mono text-[12px] font-semibold uppercase tracking-[0.14em] text-ink underline decoration-accent decoration-2 underline-offset-4 hover:text-accent-deep"
    >
      Read the full entry
    </a>
  </div>
</div>
<script type="application/json" data-timeline-data set:html={JSON.stringify(preview).replace(/</g, "\\u003c")} />
<script>
  const root = document.querySelector("[data-timeline]");
  const raw = document.querySelector("[data-timeline-data]")?.textContent;
  if (root && raw) {
    const roles = JSON.parse(raw) as {
      id: string;
      index: string;
      role: string;
      org: string;
      location: string;
      dates: string;
      summary: string;
    }[];
    const byId = new Map(roles.map((r) => [r.id, r]));
    const btns = Array.from(root.querySelectorAll("[data-timeline-btn]"));
    const indexEl = root.querySelector("[data-timeline-index]");
    const roleEl = root.querySelector("[data-timeline-role]");
    const orgEl = root.querySelector("[data-timeline-org]");
    const summaryEl = root.querySelector("[data-timeline-summary]");
    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-timeline-btn");
        const r = id ? byId.get(id) : undefined;
        if (!r) return;
        btns.forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));
        if (indexEl) indexEl.textContent = `${r.index} · ${r.dates}`;
        if (roleEl) roleEl.textContent = r.role;
        if (orgEl) orgEl.textContent = `${r.org} · ${r.location}`;
        if (summaryEl) summaryEl.textContent = r.summary;
      });
    });
  }
</script>
<style>
  [data-timeline-btn][aria-pressed="true"] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }
</style>
