---
import "../styles/global.css";
import "@fontsource/oswald/500.css";
import "@fontsource/oswald/600.css";
import "@fontsource/oswald/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Brooke Winkler — ME + AE | Michigan Tech '30",
  description = "Brooke Winkler is a first-year Mechanical + Aerospace Engineering student at Michigan Tech. FRC captain, robotics mentor, motorsports fan.",
} = Astro.props;
---
<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Brooke Winkler — Michigan Tech '30" />
    <meta
      property="og:description"
      content="First-year Mechanical + Aerospace Engineering student at Michigan Tech. FRC captain, robotics, motorsports."
    />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-full flex flex-col bg-paper text-ink">
    <slot />
    <script>
      // Reveal-on-scroll: one observer for every [data-reveal] element.
      const els = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
